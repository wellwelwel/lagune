{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "bun --bun docusaurus start --host 0.0.0.0",
    "build": "bun --bun docusaurus build",
    "swizzle": "bun --bun docusaurus swizzle",
    "clear": "bun --bun docusaurus clear",
    "serve": "bun --bun docusaurus serve --host 0.0.0.0",
    "write-translations": "bun --bun docusaurus write-translations",
    "write-heading-ids": "bun --bun docusaurus write-heading-ids",
    "typecheck": "bun --bun tsc",
    "i18n": "bun --bun ../tools/i18n/index.ts",
    "i18n:check": "bun run i18n check",
    "purge": "bun --bun --env-file=.env ../tools/purge-cache.ts"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/mdx-loader": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@docusaurus/utils": "3.10.2",
    "@docusaurus/utils-common": "3.10.2",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@paper-design/shaders": "^0.0.82",
    "@paper-design/shaders-react": "^0.0.82",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "beasties": "^0.5.5",
    "clsx": "^2.1.1",
    "mermaid": "^12.3.0",
    "postcss": "^8.5.32",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-typed": "^2.0.12",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "webpack-dev-server": "^6.1.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
