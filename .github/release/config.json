{
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "package-name": "lagune",
      "release-type": "node",
      "exclude-paths": [
        ".claude",
        ".github",
        ".vscode",
        "scripts/dashboard",
        "scripts/playground",
        "scripts/skills",
        "scripts/website",
        "test",
        "tools",
        "website"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "gemini-extension.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "scripts/plugins/antigravity/.antigravity-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".cursor-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".kimi-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".devin-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": ".hermes-plugin/plugin.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "scripts/plugins/gemini/gemini-extension.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "scripts/plugins/qwen/qwen-extension.json",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "scripts/plugins/hermes/plugin.yaml",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
