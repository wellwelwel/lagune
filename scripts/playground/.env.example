# The Lagune playground reads this file on every mount and run. It lives outside the repository and only you can read it. Uncomment and fill what you have, then mount again.

# BYOK: any OpenAI-compatible endpoint drives Factory Droid, Grok Build, Qwen Code, OpenCode, and Pi with the same model. Examples of base URLs:
#
#   OpenRouter  https://openrouter.ai/api/v1
#   OpenAI      https://api.openai.com/v1
#   xAI         https://api.x.ai/v1
#   Anthropic   https://api.anthropic.com/v1
#   Google      https://generativelanguage.googleapis.com/v1beta/openai
# The model is its id as the provider names it, such as one listed at openrouter.ai/models.
LAGUNE_BYOK_BASE_URL='https://openrouter.ai/api/v1'
LAGUNE_BYOK_API_KEY=''
LAGUNE_BYOK_MODEL='nvidia/nemotron-3-ultra-550b-a55b:free'

# Gemini CLI and Antigravity CLI: a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=''
CURSOR_API_KEY=''
